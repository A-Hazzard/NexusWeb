{
  "name": "nexus-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:https": "next dev --experimental-https -H 0.0.0.0 -p 3000",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" tsc --noEmit",
    "format": "prettier --write .",
    "check": "bun run type-check && bun run lint",
    "test": "playwright test e2e/tests/dashboard.spec.ts -c e2e/playwright.config.ts --project=chromium"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sendgrid/mail": "^8.1.6",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-youtube": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@types/nodemailer": "^7.0.9",
    "@types/three": "^0.182.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.9.0",
    "framer-motion": "^12.34.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "lucide-react": "^0.563.0",
    "next": "16.0.7",
    "nodemailer": "^8.0.1",
    "radix": "^0.0.0",
    "react": "18.3.1",
    "react-calendly": "^4.4.0",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^1.1.5",
    "three": "^0.182.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.1.6",
    "lighthouse": "^13.0.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}